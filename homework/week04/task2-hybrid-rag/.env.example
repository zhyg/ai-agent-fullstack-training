# 任选一种真实大模型配置即可（不要提交真实 .env）

# 方式 1：DeepSeek 官方接口（推荐）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 方式 2：MiniMax OpenAI 兼容接口
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-Text-01

# 方式 3：OpenAI 或其他 OpenAI 兼容网关
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 本地真实 Embedding 模型（默认无需 Key；国内网络可按需设置 HF_ENDPOINT=https://hf-mirror.com）
# RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
